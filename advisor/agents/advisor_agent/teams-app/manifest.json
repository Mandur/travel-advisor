{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
  "manifestVersion": "1.25",
  "version": "1.0.0",
  "id": "1369b48e-cc9d-43f7-891c-d846334992a8",

  "developer": {
    "name": "Contoso",
    "websiteUrl": "https://contoso.com",
    "privacyUrl": "https://contoso.com/privacy",
    "termsOfUseUrl": "https://contoso.com/terms"
  },

  "name": {
    "short": "Travel & Meeting Advisor",
    "full": "Hospitality Platform Advisor - Travel & Meeting"
  },

  "description": {
    "short": "Find hotel pricing and schedule meetings.",
    "full": "Ask the advisor to look up hotel pricing, get price forecasts, schedule meetings, and find available rooms and amenities. Powered by Azure AI Foundry."
  },

  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },

  "accentColor": "#0078D4",
  "supportsChannelFeatures": "tier1",

  "bots": [
    {
      "botId": "69cefc51-c949-4348-98ed-534cb9fe2695",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "commandLists": [
        {
          "scopes": ["personal", "team", "groupChat"],
          "commands": [
            {
              "title": "Hotel pricing",
              "description": "Get pricing for a hotel (e.g. 'Prices at Hilton Paris 2026-07-01 to 2026-07-05')"
            },
            {
              "title": "Price forecast",
              "description": "Forecast hotel prices for a destination (e.g. 'Forecast for Barcelona in August')"
            },
            {
              "title": "Schedule meeting",
              "description": "Book a meeting room (e.g. 'Schedule a board meeting for 10 people next Tuesday at 2pm')"
            },
            {
              "title": "Available rooms",
              "description": "List available meeting rooms"
            }
          ]
        }
      ]
    }
  ],

  "permissions": ["identity", "messageTeamMembers"],

  "validDomains": [
    "*.azurecontainerapps.io"
  ],

  "webApplicationInfo": {
    "id": "69cefc51-c949-4348-98ed-534cb9fe2695",
    "resource": "https://contoso.com"
  },

  "authorization": {
    "permissions": {
      "resourceSpecific": [
        {
          "type": "Application",
          "name": "TeamsActivity.Send.User"
        }
      ]
    }
  },

  "copilotAgents": {
    "customEngineAgents": [
      {
        "type": "bot",
        "id": "69cefc51-c949-4348-98ed-534cb9fe2695"
      }
    ]
  }
}